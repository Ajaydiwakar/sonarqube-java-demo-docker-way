pipeline {
    agent {
        label 'docker-worker-1'
    }

    environment {
        SONAR_HOST_URL = 'http://sonarqube:9000'
        SONAR_TOKEN    = credentials('sonar-token')
        IMAGE_NAME     = 'demo-app'
        IMAGE_TAG      = "${BUILD_NUMBER}"
        APP_PORT       = '8081'
        MAVEN_OPTS = '-Xms256m -Xmx1024m'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Compile & Test') {
            steps {
                dir('sonarqube-java-demo') {
                    sh 'mvn -B clean verify -Dmaven.wagon.rto=10000 -C'                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'sonarqube-java-demo/target/surefire-reports/*.xml'
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'sonarqube-java-demo/target/site/jacoco/**'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('sonarqube-java-demo') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn -B sonar:sonar \
                              -Dsonar.projectKey=sonarqube-java-demo \
                              -Dsonar.projectName="SonarQube Java Demo" \
                              -Dsonar.host.url=${SONAR_HOST_URL} \
                              -Dsonar.token=${SONAR_TOKEN}
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('sonarqube-java-demo') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest"
                }
            }
        }

        stage('Trivy Image Vulnerability Scan') {
            steps {
                // Scans image for HIGH and CRITICAL vulnerabilities
                sh """
                    trivy image --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      --format table \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy Container') {
            steps {
                // Stop previous instance if running and launch new container
                sh """
                    docker stop ${IMAGE_NAME} || true
                    docker rm ${IMAGE_NAME} || true
                    docker run -d \
                      --name ${IMAGE_NAME} \
                      --network jenkins-net \
                      -p ${APP_PORT}:8080 \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "Application successfully deployed! Accessible at http://localhost:${APP_PORT}"
        }
        failure {
            echo "Pipeline failed. Deployment aborted."
        }
    }
}
